# Pandiones AI Fashion Studio — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# Variables without NEXT_PUBLIC_ are server-only and never reach the browser.

# ---------------------------------------------------------------------------
# Supabase (Project Settings → API Keys). Required.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). Legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...), server only — bypasses RLS. Legacy SUPABASE_SERVICE_ROLE_KEY is also accepted.
SUPABASE_SECRET_KEY=

# Public base URL of this deployment (used to trigger the worker right after
# jobs are enqueued, and for auth email redirects). On Vercel, VERCEL_URL is
# used when this is empty.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Background worker. Required.
# ---------------------------------------------------------------------------
# Shared secret for POST /api/jobs/run (min 32 chars): openssl rand -hex 32
BACKGROUND_JOB_SECRET=
# On Vercel, set CRON_SECRET too; Vercel Cron sends it as a Bearer token.
CRON_SECRET=
# Optional tuning (defaults shown)
# WORKER_MAX_CONCURRENCY=4      # max provider calls in flight across all workers
# WORKER_BATCH_SIZE=4           # jobs claimed per claim_jobs() call
# WORKER_LEASE_SECONDS=300      # lease before a crashed worker's job is reclaimed
# WORKER_IDLE_DELAY_MS=5000     # standalone worker sleep when the queue is empty

# ---------------------------------------------------------------------------
# Google Gemini API (https://aistudio.google.com/apikey). Required for AI features.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Image generation model. Verify availability with `npm run providers:models`
# before setting. Example: gemini-3-pro-image-preview (see docs/API_PROVIDERS.md).
GEMINI_IMAGE_MODEL=
# Vision model for product analysis and automated QC (default: gemini-flash-latest).
# Pin a specific version for reproducible results and exact cost estimates.
GEMINI_ANALYSIS_MODEL=
# Set to false if the chosen image model rejects imageConfig.imageSize.
# GEMINI_SEND_IMAGE_SIZE=true
# Max reference images per request (product + model). Check the model's limit.
# GEMINI_MAX_REFERENCE_IMAGES=6
# Per-request timeout (ms).
# GEMINI_REQUEST_TIMEOUT_MS=120000
# Automated QC screening after each generated image (default true).
# AUTO_QUALITY_REVIEW=true

# ---------------------------------------------------------------------------
# Video generation. Disabled unless configured.
# ---------------------------------------------------------------------------
# "gemini-veo" (Veo via the Gemini API, uses GEMINI_API_KEY) or "none".
VIDEO_PROVIDER=none
# Veo model ID verified with `npm run providers:models`, e.g. veo-3.1-generate-preview.
VIDEO_MODEL=
# Durations (seconds) the chosen model accepts, comma separated.
# VIDEO_ALLOWED_DURATIONS=4,6,8
# true only if the model supports reference images (multi-image advertising videos).
# VIDEO_SUPPORTS_REFERENCE_IMAGES=false
# VIDEO_POLL_INTERVAL_SECONDS=15

# ---------------------------------------------------------------------------
# Cost estimation. Optional. JSON merged over src/config/pricing.ts, e.g.
# {"gemini-3-pro-image":{"kind":"tokens","currency":"USD","inputPerMillion":2,"outputTextPerMillion":12,"outputImagePerMillion":120,"source":"https://ai.google.dev/gemini-api/docs/pricing","verifiedAt":"2026-09-27"}}
# ---------------------------------------------------------------------------
PRICING_OVERRIDES_JSON=

# ---------------------------------------------------------------------------
# Tooling only (not read by the app)
# ---------------------------------------------------------------------------
# Direct Postgres connection for `npm run db:apply`
# DATABASE_URL=postgres://postgres:password@db.your-project-ref.supabase.co:5432/postgres
# Superuser connection to a disposable Postgres for `npm run test:db`
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# Path to a postgrest binary for the end-to-end tests
# POSTGREST_BIN=/usr/local/bin/postgrest
